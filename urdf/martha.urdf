<?xml version="1.0"?>
<robot name="Martha">
    
    <material name="purple">
        <color rgba=" 0.835 0.510 1 1"/>
    </material>
    <material name="white">
        <color rgba="0.941 0.941 0.941 1"/>
    </material>
    <material name="pink">
        <color rgba=" 0.996 0.800 1 1"/>
    </material>
    <material name="black">
        <color rgba=" 0 0 0 1"/>
    </material>

    <link name="base_link">
        <visual>
           <geometry>
                <box size="0.57 0.26 0.06"/>
           </geometry> 
           <origin xyz="0 0 0.03" rpy="0 0 0"/>
           <material name="purple"/>
        </visual>
    </link>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.0275" length="0.0413"/>
            </geometry>
            <origin xyz="0 0 0.02065" rpy="0 0 0"/>
            <material name="white"/>
        </visual>
    </link>

    <link name="back_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="back_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="-1.57 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="-1.57 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.23 0 0.06" rpy="0 0 0"/>
    </joint>

    <joint name="base_back_left_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="back_left_wheel"/>
        <origin xyz="-0.285 0.17 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint> 

    <joint name="base_back_right_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="back_right_wheel"/>
        <origin xyz="-0.285 -0.17 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint> 

    <joint name="base_front_left_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.285 0.17 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint> 

    <joint name="base_front_right_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.285 -0.17 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint> 
</robot>
