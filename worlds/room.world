<?xml version="1.0" ?>
<!--
  Mundo "room" - transcripcion de la Figura 1 (pag. 9) de
  Jestel et al., arXiv:2209.03097v1 (CoRL 2020).
  Solo obstaculos (trazo negro). Nodos start/goal (naranja) no incluidos.
  Escala elegida en este archivo: 20.0 x 20.0 m. No proviene del paper.
-->
<sdf version="1.6">
  <world name="room">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <model name="room_obstacles">
      <static>true</static>
      <link name="body">
      <collision name="col_0">
        <pose>0.0000 -10.0000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
      </collision>
      <visual name="vis_0">
        <pose>0.0000 -10.0000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_1">
        <pose>10.0000 0.0000 0.5000 0 0 1.57080</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
      </collision>
      <visual name="vis_1">
        <pose>10.0000 0.0000 0.5000 0 0 1.57080</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_2">
        <pose>0.0000 10.0000 0.5000 0 0 3.14159</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
      </collision>
      <visual name="vis_2">
        <pose>0.0000 10.0000 0.5000 0 0 3.14159</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_3">
        <pose>-10.0000 0.0000 0.5000 0 0 -1.57080</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
      </collision>
      <visual name="vis_3">
        <pose>-10.0000 0.0000 0.5000 0 0 -1.57080</pose>
        <geometry>
          <box><size>20.1500 0.1500 1.0000</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_4">
        <pose>-1.0000 4.4000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>6.8000 0.6000 1.0000</size></box>
        </geometry>
      </collision>
      <visual name="vis_4">
        <pose>-1.0000 4.4000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>6.8000 0.6000 1.0000</size></box>
        </geometry>
