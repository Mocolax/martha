        <pose>-1.0000 -4.6000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>6.8000 0.6000 1.0000</size></box>
        </geometry>
      </collision>
      <visual name="vis_5">
        <pose>-1.0000 -4.6000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>6.8000 0.6000 1.0000</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_6">
        <pose>6.0000 -0.2000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>0.6000 5.6000 1.0000</size></box>
        </geometry>
      </collision>
      <visual name="vis_6">
        <pose>6.0000 -0.2000 0.5000 0 0 0.00000</pose>
        <geometry>
          <box><size>0.6000 5.6000 1.0000</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_7">
        <pose>4.2000 6.8000 0.5000 0 0 0.00000</pose>
        <geometry>
          <cylinder><radius>0.5200</radius><length>1.0000</length></cylinder>
        </geometry>
      </collision>
      <visual name="vis_7">
        <pose>4.2000 6.8000 0.5000 0 0 0.00000</pose>
        <geometry>
          <cylinder><radius>0.5200</radius><length>1.0000</length></cylinder>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_8">
        <pose>-3.6000 1.8000 0.5000 0 0 0.00000</pose>
        <geometry>
          <cylinder><radius>0.6800</radius><length>1.0000</length></cylinder>
        </geometry>
      </collision>
      <visual name="vis_8">
        <pose>-3.6000 1.8000 0.5000 0 0 0.00000</pose>
        <geometry>
          <cylinder><radius>0.6800</radius><length>1.0000</length></cylinder>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <collision name="col_9">
        <pose>1.2000 0.4000 0.5000 0 0 0.00000</pose>
        <geometry>
          <cylinder><radius>0.6000</radius><length>1.0000</length></cylinder>
        </geometry>
      </collision>
      <visual name="vis_9">
        <pose>1.2000 0.4000 0.5000 0 0 0.00000</pose>
        <geometry>
          <cylinder><radius>0.6000</radius><length>1.0000</length></cylinder>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      </link>
    </model>

  </world>
