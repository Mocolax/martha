<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="martha_test_world">

    <!-- Física -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gravedad -->
    <gravity>0 0 -9.81</gravity>

    <!-- Luz -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Piso -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Obstáculo 1 -->
    <model name="box_obstacle_1">
      <static>true</static>
      <pose>1.5 0.0 0.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Obstáculo 2 -->
    <model name="box_obstacle_2">
      <static>true</static>
      <pose>0.0 1.5 0.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 0.8 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 0.8 0.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared izquierda -->
    <model name="wall_left">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared derecha -->
    <model name="wall_right">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared frontal -->
    <model name="wall_front">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared trasera -->
    <model name="wall_back">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>