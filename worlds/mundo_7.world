<?xml version="1.0"?>
<sdf version="1.6">
  <world name="martha_test_world_7">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Arena center: (-1.0, -0.8). -->
    <model name="wall_left"><static>true</static><pose>-1.0 2.2 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_right"><static>true</static><pose>-1.0 -3.8 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_front"><static>true</static><pose>2.0 -0.8 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>
    <model name="wall_back"><static>true</static><pose>-4.0 -0.8 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>

    <!-- Pillars are 0.30 m wide with at least 1.00 m clear between neighbors. -->
    <model name="pillar_1"><static>true</static><pose>-3.0 -2.5 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>
    <model name="pillar_2"><static>true</static><pose>-1.7 -2.5 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>
    <model name="pillar_3"><static>true</static><pose>-0.4 -2.5 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>
    <model name="pillar_4"><static>true</static><pose>0.9 -2.5 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>
    <model name="pillar_5"><static>true</static><pose>-3.0 -1.2 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>
    <model name="pillar_6"><static>true</static><pose>-1.7 0.4 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>
    <model name="pillar_7"><static>true</static><pose>-0.4 -1.2 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>
    <model name="pillar_8"><static>true</static><pose>0.9 0.4 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.3 1</size></box></geometry></visual></link></model>

    <model name="goal_point">
      <static>true</static><pose>-3.3 -3.1 0.2 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
