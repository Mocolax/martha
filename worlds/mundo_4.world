<?xml version="1.0"?>
<sdf version="1.6">
  <world name="martha_test_world_4">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Arena center: (-0.8, 0.6). -->
    <model name="wall_left"><static>true</static><pose>-0.8 3.6 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_right"><static>true</static><pose>-0.8 -2.4 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_front"><static>true</static><pose>2.2 0.6 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>
    <model name="wall_back"><static>true</static><pose>-3.8 0.6 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>

    <!-- A 1.10 m passage centered around the spawn. -->
    <model name="narrow_wall_1"><static>true</static><pose>-0.8 0.65 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.2 1</size></box></geometry></visual></link></model>
    <model name="narrow_wall_2"><static>true</static><pose>-0.8 -0.65 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.2 1</size></box></geometry></visual></link></model>

    <model name="goal_point">
      <static>true</static><pose>1.5 3.0 0.2 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
