<?xml version="1.0"?>
<sdf version="1.6">
  <world name="martha_test_world_9">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Arena center: (-2.2, 2.2). Martha starts near the lower-right corner. -->
    <model name="wall_left"><static>true</static><pose>-2.2 5.2 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_right"><static>true</static><pose>-2.2 -0.8 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_front"><static>true</static><pose>0.8 2.2 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>
    <model name="wall_back"><static>true</static><pose>-5.2 2.2 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>

    <!-- Dividers leave 0.95 m doors at the arena boundaries. -->
    <model name="room_divider_1"><static>true</static><pose>-2.2 1.6 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.2 1</size></box></geometry></visual></link></model>
    <model name="room_divider_2"><static>true</static><pose>-1.0 3.0 0.5 0 0 1.570796</pose><link name="link"><collision name="collision"><geometry><box><size>3.5 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.5 0.2 1</size></box></geometry></visual></link></model>
    <model name="room_obstacle"><static>true</static><pose>-3.4 3.5 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></visual></link></model>

    <model name="goal_point">
      <static>true</static><pose>-4.5 4.5 0.2 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
